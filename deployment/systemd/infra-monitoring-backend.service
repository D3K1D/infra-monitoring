[Unit]
Description=Infrastructure Monitoring Backend
After=network-online.target mysql.service
Wants=network-online.target
Requires=mysql.service

[Service]
Type=simple
User=omni
Group=omni
WorkingDirectory=/home/omni/infra-monitoring/backend
ExecStart=/home/omni/infra-monitoring/backend/venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
