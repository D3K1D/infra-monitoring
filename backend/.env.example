# Copy this file to .env and fill in real values. Do not commit .env.

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=monitoring
DB_USER=monitoring_user
DB_PASSWORD=change_me

# Auth: generate a long random string, e.g. `openssl rand -hex 32`
SECRET_KEY=change_me_to_a_long_random_value
ACCESS_TOKEN_EXPIRE_MINUTES=60

# A node is treated as offline if it has not checked in within this many seconds.
OFFLINE_TIMEOUT_SECONDS=60
